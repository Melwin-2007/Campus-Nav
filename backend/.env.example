# Application Settings
PROJECT_NAME="Campus Navigator API"
ENVIRONMENT="development"
DEBUG=True
API_PREFIX="/api"

# Server Bindings
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# Database Connection (SQLite for local dev & testing, PostgreSQL compatible)
DATABASE_URL="sqlite:///./campus_navigator.db"

# Security & Authentication (Change in production)
SECRET_KEY="campus-navigator-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Campus Geography Defaults (Apex Institute of Technology)
CAMPUS_NAME="Apex Institute of Technology"
CAMPUS_CENTER_LAT=17.659900
CAMPUS_CENTER_LON=75.906400
CAMPUS_MAX_SNAPPING_METERS=300.0
NOMINAL_WALKING_SPEED_MPS=1.3
ACCESSIBLE_WALKING_SPEED_MPS=1.0

# Initial Admin Credentials
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_EMAIL="admin@campusnav.edu"
ADMIN_DEFAULT_PASSWORD="admin123"
